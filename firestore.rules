rules_version = '2';

// Partner share links are viewed WITHOUT login, so single-document reads
// on shareLinks + partnerships are public. Everything else (including
// listing/querying those collections) still requires authentication.
service cloud.firestore {
  match /databases/{database}/documents {
    match /shareLinks/{token} {
      allow get: if true;
      allow list, create, update, delete: if request.auth != null;
    }
    match /partnerships/{partnershipId} {
      allow get: if true;
      allow list, create, update, delete: if request.auth != null;
    }
    // FCM push tokens: each user writes only their own token.
    match /fcmTokens/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Access allowlist: readable BEFORE login so the login gate can check it.
    match /appConfig/allowedEmails {
      allow get: if true;
      allow write: if request.auth != null;
    }
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
