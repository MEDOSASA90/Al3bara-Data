rules_version = '2';

// Partner share links are viewed WITHOUT login, so single-document reads
// on shareLinks + partnerships are public. Everything else (including
// listing/querying those collections) still requires authentication.
service cloud.firestore {
  match /databases/{database}/documents {
    match /shareLinks/{token} {
      allow get: if true;
      allow list, create, update, delete: if request.auth != null;
    }
    match /partnerships/{partnershipId} {
      allow get: if true;
      allow list, create, update, delete: if request.auth != null;
    }
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
